LLM_MODE=live
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
RESEARCH_PROVIDER=local
GOOGLE_SEARCH_ENGINE_ID=
LLM_TIMEOUT_SECONDS=45

EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT_SECONDS=20
EMBEDDING_FALLBACK_LOCAL=true
JD_PARSER_MODE=auto

ENVIRONMENT=staging
CORS_ALLOW_ORIGINS=https://staging-career-agent-os.example.com
REQUIRE_USER_AUTH=true
ADMIN_USER_IDS=replace-with-your-user-id
BILLING_WEBHOOK_SECRET=replace-with-staging-webhook-secret
LOG_LEVEL=INFO

# Prefer DATABASE_URL on hosted platforms.
DATABASE_URL=postgresql://user:password@host:5432/careerAgentOS
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=careerAgentOS
POSTGRES_USER=
POSTGRES_PASSWORD=
